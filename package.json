{
  "name": "gui-now-sdk",
  "version": "1.0.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "description": "SDK for gui.now \u2014 instant shareable HTML canvases",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "gui",
    "html",
    "canvas",
    "shareable",
    "ai",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gui-now/sdk.git"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "homepage": "https://gui.now",
  "bugs": {
    "url": "https://github.com/gui-now/sdk/issues"
  }
}
